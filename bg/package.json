{
	"name": "@pi-web/bg",
	"private": true,
	"type": "module",
	"description": "pi extension: bg_bash runs long commands in the background and wakes pi with a message when they exit",
	"keywords": ["pi-package"],
	"pi": { "extensions": ["./index.ts"] },
	"scripts": {
		"test": "node --test --test-concurrency=1 test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": { "typescript": "5.9.3", "@types/node": "26.6.5" }
}

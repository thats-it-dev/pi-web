{
	"name": "@thatsit/kit",
	"private": true,
	"type": "module",
	"description": "Shared styles, tokens, toast, viewport and theme-init for thatsit.app apps.",
	"exports": {
		".": "./src/index.ts",
		"./kit.css": "./src/kit.css",
		"./theme-init.js": "./src/theme-init.js"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json",
		"build": "node scripts/build.ts",
		"e2e": "playwright test -c playwright.config.ts",
		"check-api": "node scripts/check-api.ts https://kit.thatsit.app"
	},
	"dependencies": {
		"@thatsit/theme": "*",
		"lit": "3.3.3"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"typescript": "5.9.3",
		"vitest": "5.0.3",
		"vite": "8.3.4"
	}
}

{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"useDefineForClassFields": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["scripts", "test"]
}
